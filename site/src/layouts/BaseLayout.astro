---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BrowserBlocker from '../components/BrowserBlocker.astro';
import WavyShader from '../components/WavyShader.astro';

interface Props {
  title: string;
  description?: string;
  activePage?: string;
  hideFooter?: boolean;
}

const {
  title,
  description = "Build your tech fence. Take control of your data, privacy, and digital life — inspired by PewDiePie's journey.",
  activePage = '',
  hideFooter = false
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | TechFencing</title>
  <link rel="canonical" href={Astro.url.href} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Open Graph -->
  <meta property="og:title" content={`${title} | TechFencing`} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.url.href} />
  <meta property="og:image" content={new URL('/og-preview.png', Astro.site).href} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={`${title} | TechFencing`} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL('/og-preview.png', Astro.site).href} />

  <script src="../scripts/glossary-tooltip.ts"></script>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <BrowserBlocker />

  <div id="main-app">
    <Navbar activePage={activePage} />

    <main id="main-content" style="position:relative;">
      <WavyShader position="fixed" opacity={0.2} scale={3.5} rotation={1.2} grain={3} thickness={2.6} speed={3}/>
      <slot />
    </main>

    {!hideFooter && <Footer />}
  </div>
</body>
</html>

<style is:global>
  @import '../styles/tokens.css';
  @import '../styles/global.css';
  @import '../styles/effects.css';
</style>
