---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlitchText from '../components/GlitchText.astro';
import Card from '../components/Card.astro';
import DifficultyBadge from '../components/DifficultyBadge.astro';
---

<BaseLayout title="Build Your Tech Fence" activePage="home">

  <!-- ====== HERO SECTION ====== -->
  <section class="hero">
    <div class="container hero-inner">
      <div class="hero-label">// INSPIRED BY PEWDIEPIE'S TECH JOURNEY</div>
      <GlitchText text="Build Your Tech Fence" tag="h1" class="hero-title" />
      <p class="hero-subtitle">
        Take control of your data, your privacy, and your digital life.
        Stop being the product. Start being the person who decides what software
        runs on their machine, what services handle their data, and how they
        interact with the internet.
      </p>
      <div class="hero-actions">
        <a href="/guides/browsers" class="btn btn-primary">Start Here — 5 Minutes</a>
        <a href="/tldr" class="btn btn-secondary">Just Show Me The Videos</a>
      </div>
    </div>
  </section>

  <div class="flowing-line"></div>

  <!-- ====== TWO PILLARS ====== -->
  <section class="section">
    <div class="container">
      <h2 class="section-heading glitch-hover" data-text="The Two Pillars">The Two Pillars</h2>
      <p class="section-intro">
        Every solution on this site comes back to two ideas. Master these, and
        the rest is just details.
      </p>

      <div class="grid grid-2 pillars-grid">
        <div class="pillar-card">
          <div class="pillar-number">01</div>
          <h3 class="pillar-title">Friction</h3>
          <div class="flowing-line"></div>
          <p>
            Add small delays that let your brain catch up with your fingers.
            A 5-second profile switch on your phone. A DNS blocker that makes
            you pause. Removing the YouTube feed so you have to <em>choose</em>
            what to watch.
          </p>
          <p class="pillar-quote">
            "I catch myself opening apps without even thinking about it."
            <span class="quote-attr">— PewDiePie, "I Fixed YouTube!"</span>
          </p>
        </div>

        <div class="pillar-card">
          <div class="pillar-number">02</div>
          <h3 class="pillar-title">Filtering</h3>
          <div class="flowing-line"></div>
          <p>
            Remove the noise. Self-host your own services so corporations can't
            mine your data. Use browser extensions to strip out algorithmic feeds.
            Unfollow everything and rebuild with intention using RSS.
          </p>
          <p class="pillar-quote">
            "If you can replace it with something open-source, you should."
            <span class="quote-attr">— PewDiePie, "I de-Googled my life"</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== THREE LAYERS ====== -->
  <section class="section">
    <div class="container">
      <h2 class="section-heading glitch-hover" data-text="The Three Layers">The Three Layers</h2>
      <p class="section-intro">
        Your tech fence is built in three layers. Each one gives you more control.
        You don't have to do them all — even Layer 1 is a massive upgrade.
      </p>

      <div class="grid grid-3">
        <Card title="Layer 1: OS Control" href="/bible/layer-1-os" accent>
          <p>
            <strong>What software runs on your machine.</strong> Replace Windows
            with Linux. Choose an OS that doesn't spy on you, ship ads, or decide
            what you can install.
          </p>
          <p class="card-meta">Based on: PewDiePie's Linux video</p>
        </Card>

        <Card title="Layer 2: Service Control" href="/bible/layer-2-services" accent>
          <p>
            <strong>What services handle your data.</strong> De-Google your life.
            Self-host alternatives for passwords, cloud storage, email, and more.
            Own your data instead of renting it.
          </p>
          <p class="card-meta">Based on: PewDiePie's de-Google video</p>
        </Card>

        <Card title="Layer 3: Behavior Control" href="/bible/layer-3-behavior" accent>
          <p>
            <strong>How you interact with the digital world.</strong> Fight
            algorithmic feeds. Add friction to mindless scrolling. Reclaim your
            attention from apps designed to steal it.
          </p>
          <p class="card-meta">Based on: "I Fixed YouTube!" — where "tech fencing" was born</p>
        </Card>
      </div>
    </div>
  </section>

  <!-- ====== DIFFICULTY PROGRESSION ====== -->
  <section class="section">
    <div class="container">
      <h2 class="section-heading glitch-hover" data-text="Where Do You Start?">Where Do You Start?</h2>
      <p class="section-intro">
        You don't need to become a Linux wizard overnight. Pick your level,
        start there, and go deeper when you're ready.
      </p>

      <div class="difficulty-track">
        <div class="difficulty-item">
          <DifficultyBadge level={1} />
          <div class="difficulty-content">
            <h3>Switch Your Browser & Search</h3>
            <p>
              Install Firefox or Brave. Change your search engine to DuckDuckGo.
              Install uBlock Origin. <strong>Takes 5 minutes</strong>, and you've
              already escaped Google's tracking on every website you visit.
            </p>
            <a href="/guides/browsers" class="difficulty-link">Start Level 1 →</a>
          </div>
        </div>

        <div class="difficulty-item">
          <DifficultyBadge level={2} />
          <div class="difficulty-content">
            <h3>Replace & Unplug</h3>
            <p>
              Swap Google apps for open-source alternatives. Unfollow feeds.
              Install the Unhook extension. Set up an RSS reader.
              <strong>An afternoon</strong> of focused work changes your daily digital diet.
            </p>
            <a href="/guides/de-google" class="difficulty-link">Start Level 2 →</a>
          </div>
        </div>

        <div class="difficulty-item">
          <DifficultyBadge level={3} />
          <div class="difficulty-content">
            <h3>Change Your OS & Phone</h3>
            <p>
              Install Linux on your computer. Flash GrapheneOS on your phone.
              Set up a second phone profile for friction.
              <strong>A weekend project</strong> that fundamentally changes your relationship with tech.
            </p>
            <a href="/guides/linux" class="difficulty-link">Start Level 3 →</a>
          </div>
        </div>

        <div class="difficulty-item">
          <DifficultyBadge level={4} />
          <div class="difficulty-content">
            <h3>Self-Host Everything</h3>
            <p>
              Set up a Raspberry Pi server. Run Vaultwarden for passwords,
              Nextcloud for cloud storage, Pi-Hole for DNS blocking, and local
              AI models. <strong>An ongoing project</strong> — each service you add is another
              piece of your data you own.
            </p>
            <a href="/guides/self-hosting" class="difficulty-link">Start Level 4 →</a>
          </div>
        </div>

        <div class="difficulty-item">
          <DifficultyBadge level={5} />
          <div class="difficulty-content">
            <h3>The Rabbit Hole</h3>
            <p>
              Rice your desktop with a tiling window manager. Fine-tune AI models.
              Build custom tools. Host everything on a VPS.
              <strong>You never really finish this one</strong> — and that's the point.
            </p>
            <a href="/guides/ricing" class="difficulty-link">Start Level 5 →</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ====== HONEST DISCLAIMER ====== -->
  <section class="section">
    <div class="container">
      <div class="disclaimer-box">
        <h3 class="glitch-hover" data-text="A Word of Honesty">A Word of Honesty</h3>
        <p>
          This isn't easy, and it's not for everyone. PewDiePie himself still
          uses Google Maps because "it's too good." He still uses YouTube — "I
          literally can't escape." His Vaultwarden setup took 2 days. He was 30
          minutes late somewhere because the Google Maps alternative was terrible.
        </p>
        <p>
          We tell you the downsides because we respect you. Every guide on this
          site includes an <strong>"Honest Downsides"</strong> section. If
          something sucks, we'll say so.
        </p>
        <p>
          Also — we're learning too. This site was made by fans who watched the
          videos and decided to actually do it. We're not experts. We're just
          people who built the fence.
        </p>
      </div>
    </div>
  </section>

  <!-- ====== FINAL CTA ====== -->
  <section class="section cta-section">
    <div class="container cta-inner">
      <GlitchText text="Don't Want to Read?" tag="h2" class="cta-title" />
      <p class="cta-text">
        Fair enough. Just watch the three videos that started it all.
      </p>
      <a href="/tldr" class="btn btn-primary btn-lg">TL;DR — Just Watch These</a>
    </div>
  </section>

</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    padding: var(--space-20) 0 var(--space-16);
    text-align: center;
    position: relative;
  }

  .hero-inner {
    max-width: 800px;
  }

  .hero-label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--text-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin-bottom: var(--space-6);
    opacity: 0.7;
  }

  .hero :global(.hero-title) {
    font-size: var(--text-5xl);
    color: var(--text-primary);
    text-shadow:
      3px 3px 0 rgba(255, 0, 60, 0.3),
      -1px -1px 0 rgba(0, 0, 0, 0.5);
    margin-bottom: var(--space-6);
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
  }

  /* ---- Buttons ---- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-normal);
  }

  .btn:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }

  .btn-primary {
    background: var(--text-accent);
    color: var(--bg-base);
    border: 2px solid var(--text-accent);
  }

  .btn-primary:hover {
    background: var(--color-white);
    color: var(--bg-base);
    border-color: var(--color-white);
  }

  .btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 2px solid var(--border-muted);
  }

  .btn-secondary:hover {
    border-color: var(--border-primary);
    color: var(--text-accent);
  }

  .btn-lg {
    padding: var(--space-4) var(--space-8);
    font-size: var(--text-base);
  }

  /* ---- Section ---- */
  .section-heading {
    font-size: var(--text-4xl);
    text-align: center;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .section-intro {
    text-align: center;
    max-width: 650px;
    margin: 0 auto var(--space-10);
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  /* ---- Pillars ---- */
  .pillars-grid {
    gap: var(--space-8);
  }

  .pillar-card {
    background: var(--bg-card);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    position: relative;
  }

  .pillar-number {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 700;
    color: var(--text-accent);
    opacity: 0.15;
    position: absolute;
    top: var(--space-4);
    right: var(--space-6);
    line-height: 1;
  }

  .pillar-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--text-accent);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  .pillar-card p {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .pillar-quote {
    margin-top: var(--space-4);
    padding-left: var(--space-4);
    border-left: 2px solid var(--border-primary);
    font-style: italic;
    color: var(--text-muted) !important;
    font-size: var(--text-sm);
  }

  .quote-attr {
    display: block;
    margin-top: var(--space-1);
    font-style: normal;
    color: var(--text-accent);
    font-size: var(--text-xs);
    opacity: 0.7;
  }

  /* ---- Card Meta ---- */
  :global(.card-meta) {
    font-family: var(--font-display);
    font-size: var(--text-xs) !important;
    color: var(--text-muted) !important;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-top: var(--space-3) !important;
    padding-top: var(--space-3);
    border-top: 1px solid var(--border-muted);
  }

  /* ---- Difficulty Track ---- */
  .difficulty-track {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    max-width: 800px;
    margin: 0 auto;
    position: relative;
  }

  .difficulty-track::before {
    content: '';
    position: absolute;
    left: 40px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: linear-gradient(
      to bottom,
      #4ade80,
      #60a5fa,
      #fbbf24,
      #f97316,
      #ef4444
    );
    opacity: 0.3;
  }

  @media (max-width: 767px) {
    .difficulty-track::before {
      left: 20px;
    }
  }

  .difficulty-item {
    display: flex;
    gap: var(--space-6);
    align-items: flex-start;
    position: relative;
    padding-left: var(--space-4);
  }

  .difficulty-item :global(.badge) {
    flex-shrink: 0;
    margin-top: var(--space-1);
  }

  .difficulty-content h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--text-primary);
    text-transform: uppercase;
    margin-bottom: var(--space-2);
  }

  .difficulty-content p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-3);
  }

  .difficulty-link {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--text-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .difficulty-link:hover {
    color: var(--text-primary);
  }

  /* ---- Disclaimer ---- */
  .disclaimer-box {
    max-width: 800px;
    margin: 0 auto;
    padding: var(--space-8);
    background: var(--bg-card);
    border: 1px dashed var(--border-muted);
    border-radius: var(--radius-md);
    position: relative;
  }

  .disclaimer-box::before {
    content: '';
    position: absolute;
    top: -6px;
    left: var(--space-6);
    width: 60px;
    height: 20px;
    background: repeating-linear-gradient(
      -45deg,
      rgba(255, 26, 26, 0.15),
      rgba(255, 26, 26, 0.15) 4px,
      transparent 4px,
      transparent 8px
    );
    transform: rotate(-2deg);
  }

  .disclaimer-box h3 {
    font-family: var(--font-display);
    font-size: var(--text-xl);
    color: var(--text-accent);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  .disclaimer-box p {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    font-size: var(--text-sm);
  }

  /* ---- CTA Section ---- */
  .cta-section {
    text-align: center;
    padding: var(--space-16) 0;
  }

  .cta-inner {
    max-width: 600px;
  }

  :global(.cta-title) {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .cta-text {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    margin-bottom: var(--space-8);
  }
</style>
