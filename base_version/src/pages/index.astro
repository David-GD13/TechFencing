---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlitchText from '../components/GlitchText.astro';
import Card from '../components/Card.astro';
import DifficultyBadge from '../components/DifficultyBadge.astro';
import ScrollProgressTrail from '../components/ScrollProgressTrail.astro';
---

<BaseLayout title="Build Your Tech Fence" activePage="home">
  <ScrollProgressTrail />

  <!-- ====== HERO SECTION ====== -->
  <section class="cine-section hero" data-section-id="hero" data-section-label="Home">
    <div class="cine-heading">
      <div class="hero-label">// INSPIRED BY PEWDIEPIE'S TECH JOURNEY</div>
      <GlitchText text="Build Your Tech Fence" tag="h1" class="hero-title" />
    </div>
    <div class="cine-content">
      <p class="hero-subtitle">
        Take control of your data, your privacy, and your digital life.
        Stop being the product. Start being the person who decides what software
        runs on their machine, what services handle their data, and how they
        interact with the internet.
      </p>
      <div class="hero-actions">
        <a href="/guides/browsers" class="btn btn-primary">Start Here — 5 Minutes</a>
        <a href="/tldr" class="btn btn-secondary">Just Show Me The Videos</a>
      </div>
    </div>
  </section>

  <div class="section-spacer"></div>

  <!-- ====== TWO PILLARS ====== -->
  <section class="cine-section" data-section-id="pillars" data-section-label="Two Pillars">
    <div class="container">
      <div class="cine-heading">
        <h2 class="section-heading glitch-hover" data-text="The Two Pillars">The Two Pillars</h2>
      </div>
      <div class="cine-content">
        <p class="section-intro">
          Every solution on this site comes back to two ideas. Understand these,
          and the rest is just details.
        </p>

        <div class="grid grid-2 pillars-grid">
          <div class="pillar-card">
            <div class="pillar-number">01</div>
            <h3 class="pillar-title">You Are Not The Product</h3>
            <div class="flowing-line"></div>
            <p>
              Every "free" service has a cost — your data, your attention, your
              autonomy. Google knows your search history, your location history,
              your contacts, your emails. The trade-off between control and
              convenience is real, but being aware of it lets you <em>choose</em>
              intentionally instead of sleepwalking into surveillance.
            </p>
            <p class="pillar-quote">
              "I realized Google literally knows everything about me. Everything."
              <span class="quote-attr">— PewDiePie, "I de-Googled my life"</span>
            </p>
          </div>

          <div class="pillar-card">
            <div class="pillar-number">02</div>
            <h3 class="pillar-title">Curing Algo Brain</h3>
            <div class="flowing-line"></div>
            <p>
              Algorithms are designed to keep you scrolling, clicking, consuming.
              The cure is two tools: <strong>friction</strong> (small delays that
              let your brain catch up with your fingers) and <strong>filtering</strong>
              (removing algorithmic feeds, rebuilding your digital diet with
              intention). Together, they break the loop.
            </p>
            <p class="pillar-quote">
              "I catch myself opening apps without even thinking about it."
              <span class="quote-attr">— PewDiePie, "I Fixed YouTube!"</span>
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="section-spacer"></div>

  <!-- ====== THREE LAYERS ====== -->
  <section class="cine-section" data-section-id="layers" data-section-label="Three Layers">
    <div class="container">
      <div class="cine-heading">
        <h2 class="section-heading glitch-hover" data-text="The Three Layers">The Three Layers</h2>
      </div>
      <div class="cine-content">
        <p class="section-intro">
          Your tech fence is built in three layers. Each one gives you more control.
          You don't have to do them all — even Layer 1 is a massive upgrade.
        </p>

        <div class="grid grid-3">
          <Card title="Layer 1: OS Control" href="/bible/layer-1-os" accent>
            <p>
              <strong>What software runs on your machine.</strong> Replace Windows
              with Linux. Choose an OS that doesn't spy on you, ship ads, or decide
              what you can install.
            </p>
            <p class="card-meta">Based on: PewDiePie's Linux video</p>
          </Card>

          <Card title="Layer 2: Service Control" href="/bible/layer-2-services" accent>
            <p>
              <strong>What services handle your data.</strong> De-Google your life.
              Self-host alternatives for passwords, cloud storage, email, and more.
              Own your data instead of renting it.
            </p>
            <p class="card-meta">Based on: PewDiePie's de-Google video</p>
          </Card>

          <Card title="Layer 3: Behavior Control" href="/bible/layer-3-behavior" accent>
            <p>
              <strong>How you interact with the digital world.</strong> Fight
              algorithmic feeds. Add friction to mindless scrolling. Reclaim your
              attention from apps designed to steal it.
            </p>
            <p class="card-meta">Based on: "I Fixed YouTube!" — where "tech fencing" was born</p>
          </Card>
        </div>

        <div class="section-cta">
          <a href="/bible" class="btn btn-secondary">Explore The Bible →</a>
        </div>
      </div>
    </div>
  </section>

  <div class="section-spacer"></div>

  <!-- ====== GETTING STARTED (slim) ====== -->
  <section class="cine-section" data-section-id="guides" data-section-label="Getting Started">
    <div class="container">
      <div class="cine-heading">
        <h2 class="section-heading glitch-hover" data-text="Getting Started">Getting Started</h2>
      </div>
      <div class="cine-content">
        <p class="section-intro">
          You don't need to become a Linux wizard overnight. Here are three
          places to start — pick the one that fits.
        </p>

        <div class="grid grid-3">
          <a href="/guides/browsers" class="guide-preview-card">
            <DifficultyBadge level={1} />
            <h3>Switch Your Browser</h3>
            <p>Install Firefox or Brave. Change your search engine. Install uBlock Origin. Takes 5 minutes.</p>
          </a>

          <a href="/guides/de-google" class="guide-preview-card">
            <DifficultyBadge level={2} />
            <h3>De-Google Your Life</h3>
            <p>Replace Google services with open-source alternatives you can trust. An afternoon of work.</p>
          </a>

          <a href="/guides/linux" class="guide-preview-card">
            <DifficultyBadge level={3} />
            <h3>Install Linux</h3>
            <p>Replace Windows with an OS that respects you. A weekend project that changes everything.</p>
          </a>
        </div>

        <div class="section-cta">
          <a href="/guides" class="btn btn-secondary">See All 9 Guides →</a>
        </div>
      </div>
    </div>
  </section>

  <div class="section-spacer"></div>

  <!-- ====== HONEST DISCLAIMER ====== -->
  <section class="cine-section" data-section-id="honesty" data-section-label="Honesty">
    <div class="container">
      <div class="cine-heading">
        <h3 class="disclaimer-heading glitch-hover" data-text="A Word of Honesty">A Word of Honesty</h3>
      </div>
      <div class="cine-content">
        <div class="disclaimer-box">
          <p>
            This isn't easy, and it's not for everyone. PewDiePie himself still
            uses Google Maps because "it's too good." He still uses YouTube — "I
            literally can't escape." His Vaultwarden setup took 2 days. He was 30
            minutes late somewhere because the Google Maps alternative was terrible.
          </p>
          <p>
            We tell you the downsides because we respect you. Every guide on this
            site includes an <strong>"Honest Downsides"</strong> section. If
            something sucks, we'll say so.
          </p>
          <p>
            Also — we're learning too. This site was made by fans who watched the
            videos and decided to actually do it. We're not experts. We're just
            people who built the fence.
          </p>
        </div>
      </div>
    </div>
  </section>

  <div class="section-spacer"></div>

  <!-- ====== EXTRAS ====== -->
  <section class="cine-section" data-section-id="extras" data-section-label="Extras">
    <div class="container">
      <div class="cine-heading">
        <h2 class="section-heading glitch-hover" data-text="Extras">Extras</h2>
      </div>
      <div class="cine-content">
        <p class="section-intro">
          More resources, references, and rabbit holes.
        </p>

        <div class="extras-grid">
          <a href="/tldr" class="extra-card">
            <h3>TL;DR</h3>
            <p>Just watch the three PewDiePie videos that started everything.</p>
          </a>

          <a href="/arsenal" class="extra-card">
            <h3>The Arsenal</h3>
            <p>Every piece of hardware and software PewDiePie actually uses.</p>
          </a>

          <a href="/damned" class="extra-card">
            <h3>The Damned</h3>
            <p>Services we don't recommend — and the honest reasons why.</p>
          </a>

          <a href="/experiments" class="extra-card">
            <h3>Experiments</h3>
            <p>Beyond the fence — supercomputers, local AI, and deeper rabbit holes.</p>
          </a>

          <a href="/glossary" class="extra-card">
            <h3>Glossary</h3>
            <p>Every tech term on this site, explained without jargon.</p>
          </a>

          <a href="/about" class="extra-card">
            <h3>About</h3>
            <p>Who built this site, why, and what we believe.</p>
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ScrollToPlugin } from 'gsap/ScrollToPlugin';

  gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

  // Expose section triggers globally for progress trail
  (window as any).__sectionTriggers = {};

  function initCinematicScroll() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      document.querySelectorAll<HTMLElement>('.cine-content').forEach(el => {
        el.style.opacity = '1';
      });
      return;
    }

    const sections = gsap.utils.toArray<HTMLElement>('.cine-section');
    const sectionTriggers: ScrollTrigger[] = [];

    // ---- Global timing config (tweak these to control all animations) ----
    // These are relative units — actual speed depends on scroll distance (end value).
    // Total timeline = enter + reveal + hold + exit. Each section's scroll range
    // is divided proportionally across these phases.
    const TIMING = {
      enterDuration: 2.0,    // how long heading takes to slide in
      revealDuration: 1.4,    // how long content takes to appear
      holdDuration: 1.35,     // reading time before exit starts
      exitDuration: 1.4,      // how long exit animation takes
      slideDistance: 200,      // px distance for horizontal slides
      headingLift: -80,       // px heading moves up during exit
      scrollRange: '+=100%',  // scroll distance per section (viewport %)
    };

    // Measure navbar height so hero pins immediately (no free-scroll gap)
    const navbar = document.querySelector('.navbar');
    const navHeight = navbar ? navbar.getBoundingClientRect().height : 0;

    sections.forEach((section, i) => {
      const heading = section.querySelector('.cine-heading') as HTMLElement;
      const content = section.querySelector('.cine-content') as HTMLElement;
      if (!heading || !content) return;

      const isHero = section.dataset.sectionId === 'hero';
      const isLast = i === sections.length - 1;
      const sectionId = section.dataset.sectionId || `section-${i}`;

      // Hero: pin as soon as page starts scrolling (offset by navbar height)
      // Others: pin when section top reaches viewport top
      const pinStart = isHero ? `top top+=${navHeight}` : 'top top';

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: pinStart,
          end: TIMING.scrollRange,
          pin: true,
          pinSpacing: true,
          scrub: 2.5,
          invalidateOnRefresh: true,
          id: sectionId,
        },
      });

      // Store the trigger
      if (tl.scrollTrigger) {
        sectionTriggers.push(tl.scrollTrigger);
        (window as any).__sectionTriggers[sectionId] = tl.scrollTrigger;
      }

      if (isHero) {
        // Hero: visible from start, fades out vertically
        gsap.set(content, { opacity: 1, y: 0 });

        tl.addLabel('visible')
          .to(heading, { y: -60, opacity: 0, duration: TIMING.exitDuration }, 0.65)
          .to(content, { y: -40, opacity: 0, duration: TIMING.exitDuration }, 0.65);
      } else {
        // Non-hero sections: horizontal slideshow transitions
        gsap.set(heading, { x: TIMING.slideDistance, opacity: 0 });
        gsap.set(content, { x: TIMING.slideDistance * 0.75, opacity: 0 });

        // Phase 1: Heading slides in from right
        tl.addLabel('enter')
          .to(heading, { x: 0, opacity: 1, duration: TIMING.enterDuration, ease: 'power2.out' })

        // Phase 2: Content slides in (heading stays in place)
          .addLabel('reveal')
          .to(content, { x: 0, opacity: 1, duration: TIMING.revealDuration, ease: 'power2.out' })

        // Phase 3: Hold for reading (heading + content both fully visible)
          .addLabel('hold')
          .to({}, { duration: TIMING.holdDuration });

        // Phase 4: Exit — heading lifts up, then everything slides left
        tl.addLabel('exit')
          .to(heading, { y: TIMING.headingLift, opacity: 0, duration: TIMING.exitDuration, ease: 'power1.in' })
          .to(content, { x: -TIMING.slideDistance, opacity: 0, duration: TIMING.exitDuration, ease: 'power1.in' }, '<0.05');
      }
    });

    ScrollTrigger.refresh();

    // ---- Cinematic Mode (auto-scroll on scroll input) ----
    let cinematicMode = localStorage.getItem('cinematicMode') !== 'false';
    let isAutoScrolling = false;
    let currentSectionIndex = 0;

    function getCinematicMode() {
      return localStorage.getItem('cinematicMode') !== 'false';
    }

    function findCurrentSectionIndex() {
      const scrollY = window.scrollY;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;

      // If we're near the bottom (footer area), return totalSections (footer index)
      if (scrollY >= maxScroll - 50) {
        return totalSections;
      }

      // If we're past the last section's end, we're in the footer zone
      const lastST = sectionTriggers[sectionTriggers.length - 1];
      if (lastST && scrollY > lastST.end) {
        return totalSections;
      }

      let idx = 0;
      for (let i = 0; i < sectionTriggers.length; i++) {
        if (scrollY >= sectionTriggers[i].start - 10) {
          idx = i;
        }
      }
      return idx;
    }

    // Scroll target: 50% into section range (where content is fully revealed)
    // For hero: go to start. For footer: go to document bottom.
    const CONTENT_VISIBLE_RATIO = 0.5;
    const totalSections = sectionTriggers.length; // includes footer pseudo-target

    function getScrollTarget(index: number): number {
      if (index < 0) return 0;
      // Footer: scroll to document bottom
      if (index >= totalSections) {
        return document.documentElement.scrollHeight - window.innerHeight;
      }
      const st = sectionTriggers[index];
      const sId = sections[index]?.dataset.sectionId;
      if (sId === 'hero') return st.start;
      return st.start + (st.end - st.start) * CONTENT_VISIBLE_RATIO;
    }

    function handleWheel(e: WheelEvent) {
      cinematicMode = getCinematicMode();
      if (!cinematicMode || isAutoScrolling) {
        if (isAutoScrolling) e.preventDefault();
        return;
      }
      e.preventDefault();
      isAutoScrolling = true;

      currentSectionIndex = findCurrentSectionIndex();
      const direction = e.deltaY > 0 ? 1 : -1;
      // Allow scrolling one past the last section (to reach footer)
      const maxIndex = totalSections; // totalSections = footer
      const nextIndex = Math.max(0, Math.min(maxIndex, currentSectionIndex + direction));

      if (nextIndex === currentSectionIndex) {
        isAutoScrolling = false;
        return;
      }

      currentSectionIndex = nextIndex;

      gsap.to(window, {
        scrollTo: { y: getScrollTarget(nextIndex) },
        duration: 0.0,
        ease: 'power2.inOut',
        onComplete: () => {
          setTimeout(() => { isAutoScrolling = false; }, 100);
        },
      });
    }

    // Touch handling for cinematic mode
    let touchStartY = 0;

    function handleTouchStart(e: TouchEvent) {
      touchStartY = e.touches[0].clientY;
    }

    function handleTouchEnd(e: TouchEvent) {
      cinematicMode = getCinematicMode();
      if (!cinematicMode || isAutoScrolling) return;

      const touchEndY = e.changedTouches[0].clientY;
      const diff = touchStartY - touchEndY;

      if (Math.abs(diff) < 30) return; // too small, ignore

      isAutoScrolling = true;
      currentSectionIndex = findCurrentSectionIndex();
      const direction = diff > 0 ? 1 : -1;
      const maxIndex = totalSections;
      const nextIndex = Math.max(0, Math.min(maxIndex, currentSectionIndex + direction));

      if (nextIndex === currentSectionIndex) {
        isAutoScrolling = false;
        return;
      }

      currentSectionIndex = nextIndex;

      gsap.to(window, {
        scrollTo: { y: getScrollTarget(nextIndex) },
        duration: 0.0,
        ease: 'power2.inOut',
        onComplete: () => {
          setTimeout(() => { isAutoScrolling = false; }, 100);
        },
      });
    }

    // Attach cinematic listeners
    window.addEventListener('wheel', handleWheel, { passive: false });
    window.addEventListener('touchstart', handleTouchStart, { passive: true });
    window.addEventListener('touchend', handleTouchEnd, { passive: true });

    // Listen for toggle from navbar
    window.addEventListener('cinematicModeChange', ((e: CustomEvent) => {
      cinematicMode = e.detail.enabled;
    }) as EventListener);
  }

  // Init
  initCinematicScroll();

  // When browser blocker is dismissed, main-app goes from display:none to visible.
  // GSAP measured everything as zero while hidden — rebuild all ScrollTriggers.
  window.addEventListener('blocker-dismissed', () => {
    ScrollTrigger.getAll().forEach(st => st.kill());
    (window as any).__sectionTriggers = {};
    initCinematicScroll();
  });

  // Astro page transition support
  document.addEventListener('astro:after-swap', () => {
    ScrollTrigger.getAll().forEach(st => st.kill());
    (window as any).__sectionTriggers = {};
    if (document.querySelector('.cine-section')) {
      initCinematicScroll();
    }
  });
</script>

<style>
  /* ---- Layout overrides (homepage only) ---- */
  :global(#main-content) {
    overflow: visible;
  }

  /* ---- Section Spacers ---- */
  .section-spacer {
    height: 35vh;
    position: relative;
  }

  /* ---- Cinematic Sections ---- */
  .cine-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-8) 0;
    box-sizing: border-box;
    overflow: hidden;
  }

  /* Per-section dark background with gradient edges */
  .cine-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(10, 0, 0, 0.55) 12%,
      rgba(10, 0, 0, 0.55) 88%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  /* Hero: no top fade (starts dark) */
  .hero::before {
    background: linear-gradient(
      to bottom,
      rgba(10, 0, 0, 0.55) 0%,
      rgba(10, 0, 0, 0.55) 88%,
      transparent 100%
    );
  }

  /* Content sits above the background */
  .cine-section > :global(*) {
    position: relative;
    z-index: 1;
  }

  .cine-heading {
    text-align: center;
    will-change: transform, opacity;
  }

  .cine-content {
    opacity: 0;
    will-change: transform, opacity;
  }

  /* ---- Reduced Motion ---- */
  @media (prefers-reduced-motion: reduce) {
    .cine-content {
      opacity: 1 !important;
      transform: none !important;
    }

    .cine-heading {
      transform: none !important;
      opacity: 1 !important;
    }
  }

  /* ---- Hero ---- */
  .hero {
    text-align: center;
    padding-bottom: calc(var(--space-8) + 124px);
  }

  .hero .cine-content {
    opacity: 1;
  }

  .hero-label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin-bottom: var(--space-6);
  }

  .hero :global(.hero-title) {
    font-size: var(--text-5xl);
    color: var(--text-primary);
    text-shadow:
      3px 3px 0 rgba(212, 84, 94, 0.3),
      -1px -1px 0 rgba(0, 0, 0, 0.5);
    margin-bottom: var(--space-6);
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin-bottom: var(--space-8);
    max-width: 650px;
    margin-left: auto;
    margin-right: auto;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
  }

  /* ---- Buttons ---- */
  .btn {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    text-decoration: none;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: all var(--transition-normal);
  }

  .btn:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }

  .btn-primary {
    background: var(--text-accent);
    color: var(--bg-base);
    border: 2px solid var(--text-accent);
  }

  .btn-primary:hover {
    background: var(--color-white);
    color: var(--bg-base);
    border-color: var(--color-white);
  }

  .btn-secondary {
    background: transparent;
    color: var(--text-primary);
    border: 2px solid var(--border-muted);
  }

  .btn-secondary:hover {
    border-color: var(--border-primary);
    color: var(--text-accent);
  }

  /* ---- Section Headings ---- */
  .section-heading {
    font-size: var(--text-4xl);
    text-align: center;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  .section-intro {
    text-align: center;
    max-width: 650px;
    margin: 0 auto var(--space-10);
    font-size: var(--text-lg);
    color: var(--text-secondary);
  }

  .section-cta {
    text-align: center;
    margin-top: var(--space-8);
  }

  /* ---- Pillars ---- */
  .pillars-grid {
    gap: var(--space-8);
  }

  .pillar-card {
    background: var(--bg-card);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-md);
    padding: var(--space-8);
    position: relative;
  }

  .pillar-number {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 700;
    color: var(--text-accent);
    opacity: 0.15;
    position: absolute;
    top: var(--space-4);
    right: var(--space-6);
    line-height: 1;
  }

  .pillar-title {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    color: var(--text-accent);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  .pillar-card p {
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .pillar-quote {
    margin-top: var(--space-4);
    padding-left: var(--space-4);
    border-left: 2px solid var(--border-primary);
    font-style: italic;
    color: var(--text-muted) !important;
    font-size: var(--text-sm);
  }

  .quote-attr {
    display: block;
    margin-top: var(--space-1);
    font-style: normal;
    color: var(--text-accent);
    font-size: var(--text-xs);
    opacity: 0.7;
  }

  /* ---- Card Meta ---- */
  :global(.card-meta) {
    font-family: var(--font-display);
    font-size: var(--text-xs) !important;
    color: var(--text-muted) !important;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-top: var(--space-3) !important;
