---
import BaseLayout from '../../layouts/BaseLayout.astro';
import GlitchText from '../../components/GlitchText.astro';
import DifficultyBadge from '../../components/DifficultyBadge.astro';
import ScrollProgressTrail from '../../components/ScrollProgressTrail.astro';
---

<BaseLayout title="Guides" activePage="guides" description="Step-by-step guides for building your tech fence — from switching your browser to self-hosting everything.">

  <ScrollProgressTrail />

  <!-- ====== HERO ====== -->
  <section class="cine-section hero" data-section-id="hero" data-section-label="Guides">
    <div class="container">
      <div class="cine-heading">
        <div class="hero-label">// STEP-BY-STEP, HONEST GUIDES</div>
        <GlitchText text="Guides" tag="h1" class="page-title" />
      </div>
      <div class="cine-content">
        <p class="hero-subtitle">
          Each guide is a concrete, actionable walkthrough. Sorted by difficulty —
          start wherever you're comfortable. Every guide includes honest downsides.
        </p>
      </div>
    </div>
  </section>

  <div class="section-spacer"></div>

  <!-- ====== GROUP 1: GETTING STARTED ====== -->
  <section class="cine-section guide-group" data-section-id="group1" data-section-label="Getting Started">
    <div class="container">
      <div class="cine-heading">
        <div class="group-number">01</div>
        <h2 class="section-heading glitch-hover" data-text="Getting Started">Getting Started</h2>
      </div>
      <div class="cine-content">
        <div class="guides-grid">
          <a href="/guides/browsers" class="guide-card">
            <div class="guide-card-number">01</div>
            <DifficultyBadge level={1} />
            <h3>Switch Your Browser</h3>
            <p>The easiest first step. 5 minutes to escape Google's tracking on every site you visit.</p>
            <span class="guide-cta">Read Guide →</span>
            <div class="completion-status" data-check-page="guides/browsers"></div>
          </a>
          <a href="/guides/linux" class="guide-card">
            <div class="guide-card-number">02</div>
            <DifficultyBadge level={3} />
            <h3>Install Linux</h3>
            <p>Replace Windows with an OS that actually respects you.</p>
            <span class="guide-cta">Read Guide →</span>
            <div class="completion-status" data-check-page="guides/linux"></div>
          </a>
          <a href="/guides/de-google" class="guide-card">
            <div class="guide-card-number">03</div>
            <DifficultyBadge level={3} />
            <h3>De-Google Your Life</h3>
            <p>Replace Google services with alternatives you can actually trust.</p>
            <span class="guide-cta">Read Guide →</span>
            <div class="completion-status" data-check-page="guides/de-google"></div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="section-spacer"></div>

  <!-- ====== GROUP 2: FULL CONTROL ====== -->
  <section class="cine-section guide-group" data-section-id="group2" data-section-label="Full Control">
    <div class="container">
      <div class="cine-heading">
        <div class="group-number">02</div>
        <h2 class="section-heading glitch-hover" data-text="Full Control">Full Control</h2>
      </div>
      <div class="cine-content">
        <div class="guides-grid">
          <a href="/guides/self-hosting" class="guide-card">
            <div class="guide-card-number">04</div>
            <DifficultyBadge level={4} />
            <h3>Self-Host Your Services</h3>
            <p>Run your own server. Own your data for real.</p>
            <span class="guide-cta">Read Guide →</span>
            <div class="completion-status" data-check-page="guides/self-hosting"></div>
          </a>
          <a href="/guides/open-source-alternatives" class="guide-card">
            <div class="guide-card-number">05</div>
            <DifficultyBadge level={3} />
            <h3>Open-Source Alternatives</h3>
            <p>A catalog of replacements for every app you're giving up.</p>
            <span class="guide-cta">Read Guide →</span>
            <div class="completion-status" data-check-page="guides/open-source-alternatives"></div>
          </a>
          <a href="/guides/fix-youtube" class="guide-card">
            <div class="guide-card-number">06</div>
            <DifficultyBadge level={2} />
            <h3>Fix YouTube</h3>
            <p>The video that coined "tech fencing." Take back your attention from the algorithm.</p>
            <span class="guide-cta">Read Guide →</span>
            <div class="completion-status" data-check-page="guides/fix-youtube"></div>
          </a>
        </div>
      </div>
    </div>
  </section>

  <div class="section-spacer"></div>

  <!-- ====== GROUP 3: GOING DEEPER ====== -->
  <section class="cine-section guide-group" data-section-id="group3" data-section-label="Going Deeper">
    <div class="container">
      <div class="cine-heading">
        <div class="group-number">03</div>
        <h2 class="section-heading glitch-hover" data-text="Going Deeper">Going Deeper</h2>
      </div>
      <div class="cine-content">
        <div class="guides-grid">
          <a href="/guides/control-your-phone" class="guide-card">
            <div class="guide-card-number">07</div>
            <DifficultyBadge level={3} />
            <h3>Control Your Phone</h3>
            <p>Your phone is the biggest attention thief. Time to fence it.</p>
            <span class="guide-cta">Read Guide →</span>
            <div class="completion-status" data-check-page="guides/control-your-phone"></div>
          </a>
          <a href="/guides/own-your-ai" class="guide-card">
            <div class="guide-card-number">08</div>
            <DifficultyBadge level={4} />
            <h3>Own Your AI</h3>
            <p>Run AI models locally. No data leaves your machine.</p>
            <span class="guide-cta">Read Guide →</span>
            <div class="completion-status" data-check-page="guides/own-your-ai"></div>
          </a>
          <a href="/guides/ricing" class="guide-card">
            <div class="guide-card-number">09</div>
            <DifficultyBadge level={5} />
            <h3>Rice Your Desktop</h3>
            <p>The rabbit hole. Make your desktop look like a nuclear reactor control panel.</p>
            <span class="guide-cta">Read Guide →</span>
            <div class="completion-status" data-check-page="guides/ricing"></div>
          </a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<script>
  // Read-only completion status indicators
  function updateCompletionStatus() {
    const STORAGE_KEY = 'tf-progress';
    let progress: Record<string, boolean>;
    try {
      progress = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
    } catch {
      progress = {};
    }

    document.querySelectorAll<HTMLElement>('.completion-status').forEach(el => {
      const pageId = el.dataset.checkPage;
      if (!pageId) return;

      const completed = !!progress[pageId];
      if (completed) {
        el.innerHTML = '<span class="status-icon">✓</span> Completed';
        el.classList.add('is-completed');
      } else {
        el.innerHTML = 'Not yet read';
        el.classList.remove('is-completed');
      }
    });
  }

  updateCompletionStatus();
  document.addEventListener('astro:after-swap', updateCompletionStatus);
  window.addEventListener('reading-progress-change', updateCompletionStatus);
</script>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { ScrollToPlugin } from 'gsap/ScrollToPlugin';

  gsap.registerPlugin(ScrollTrigger, ScrollToPlugin);

  // Expose section triggers globally for progress trail
  (window as any).__sectionTriggers = {};

  function initCinematicScroll() {
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    if (prefersReducedMotion) {
      document.querySelectorAll<HTMLElement>('.cine-content').forEach(el => {
        el.style.opacity = '1';
      });
      return;
    }

    const sections = gsap.utils.toArray<HTMLElement>('.cine-section');
    const sectionTriggers: ScrollTrigger[] = [];

    const TIMING = {
      enterDuration: 2.0,
      revealDuration: 1.4,
      holdDuration: 1.35,
      exitDuration: 1.4,
      slideDistance: 200,
      headingLift: -80,
      scrollRange: '+=100%',
    };

    const navbar = document.querySelector('.navbar');
    const navHeight = navbar ? navbar.getBoundingClientRect().height : 0;

    sections.forEach((section, i) => {
      const heading = section.querySelector('.cine-heading') as HTMLElement;
      const content = section.querySelector('.cine-content') as HTMLElement;
      if (!heading || !content) return;

      const isHero = section.dataset.sectionId === 'hero';
      const sectionId = section.dataset.sectionId || `section-${i}`;

      const pinStart = isHero ? `top top+=${navHeight}` : 'top top';

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: section,
          start: pinStart,
          end: TIMING.scrollRange,
          pin: true,
          pinSpacing: true,
          scrub: 2.5,
          invalidateOnRefresh: true,
          id: sectionId,
        },
      });

      if (tl.scrollTrigger) {
        sectionTriggers.push(tl.scrollTrigger);
        (window as any).__sectionTriggers[sectionId] = tl.scrollTrigger;
      }

      if (isHero) {
        gsap.set(content, { opacity: 1, y: 0 });

        tl.addLabel('visible')
          .to(heading, { y: -60, opacity: 0, duration: TIMING.exitDuration }, 0.65)
          .to(content, { y: -40, opacity: 0, duration: TIMING.exitDuration }, 0.65);
      } else {
        gsap.set(heading, { x: TIMING.slideDistance, opacity: 0 });
        gsap.set(content, { x: TIMING.slideDistance * 0.75, opacity: 0 });

        tl.addLabel('enter')
          .to(heading, { x: 0, opacity: 1, duration: TIMING.enterDuration, ease: 'power2.out' })

          .addLabel('reveal')
          .to(content, { x: 0, opacity: 1, duration: TIMING.revealDuration, ease: 'power2.out' })

          .addLabel('hold')
          .to({}, { duration: TIMING.holdDuration });

        tl.addLabel('exit')
          .to(heading, { y: TIMING.headingLift, opacity: 0, duration: TIMING.exitDuration, ease: 'power1.in' })
          .to(content, { x: -TIMING.slideDistance, opacity: 0, duration: TIMING.exitDuration, ease: 'power1.in' }, '<0.05');
      }
    });

    ScrollTrigger.refresh();

    // ---- Auto-Scroll Mode ----
    let cinematicMode = localStorage.getItem('cinematicMode') !== 'false';
    let isAutoScrolling = false;
    let currentSectionIndex = 0;

    function getCinematicMode() {
      return localStorage.getItem('cinematicMode') !== 'false';
    }

    function findCurrentSectionIndex() {
      const scrollY = window.scrollY;
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;

      if (scrollY >= maxScroll - 50) {
        return totalSections;
      }

      const lastST = sectionTriggers[sectionTriggers.length - 1];
      if (lastST && scrollY > lastST.end) {
        return totalSections;
      }

      let idx = 0;
      for (let i = 0; i < sectionTriggers.length; i++) {
        if (scrollY >= sectionTriggers[i].start - 10) {
          idx = i;
        }
      }
      return idx;
    }

    const CONTENT_VISIBLE_RATIO = 0.5;
    const totalSections = sectionTriggers.length;

    function getScrollTarget(index: number): number {
      if (index < 0) return 0;
      if (index >= totalSections) {
        return document.documentElement.scrollHeight - window.innerHeight;
      }
      const st = sectionTriggers[index];
      const sId = sections[index]?.dataset.sectionId;
      if (sId === 'hero') return st.start;
      return st.start + (st.end - st.start) * CONTENT_VISIBLE_RATIO;
    }

    function handleWheel(e: WheelEvent) {
      cinematicMode = getCinematicMode();
      if (!cinematicMode || isAutoScrolling) {
        if (isAutoScrolling) e.preventDefault();
        return;
      }
      e.preventDefault();
      isAutoScrolling = true;

      currentSectionIndex = findCurrentSectionIndex();
      const direction = e.deltaY > 0 ? 1 : -1;
      const maxIndex = totalSections;
      const nextIndex = Math.max(0, Math.min(maxIndex, currentSectionIndex + direction));

      if (nextIndex === currentSectionIndex) {
        isAutoScrolling = false;
        return;
      }

      currentSectionIndex = nextIndex;

      gsap.to(window, {
        scrollTo: { y: getScrollTarget(nextIndex) },
        duration: 0.0,
        ease: 'power2.inOut',
        onComplete: () => {
          setTimeout(() => { isAutoScrolling = false; }, 100);
        },
      });
    }

    let touchStartY = 0;

    function handleTouchStart(e: TouchEvent) {
      touchStartY = e.touches[0].clientY;
    }

    function handleTouchEnd(e: TouchEvent) {
      cinematicMode = getCinematicMode();
      if (!cinematicMode || isAutoScrolling) return;

      const touchEndY = e.changedTouches[0].clientY;
      const diff = touchStartY - touchEndY;

      if (Math.abs(diff) < 30) return;

      isAutoScrolling = true;
      currentSectionIndex = findCurrentSectionIndex();
      const direction = diff > 0 ? 1 : -1;
      const maxIndex = totalSections;
      const nextIndex = Math.max(0, Math.min(maxIndex, currentSectionIndex + direction));

      if (nextIndex === currentSectionIndex) {
        isAutoScrolling = false;
        return;
      }

      currentSectionIndex = nextIndex;

      gsap.to(window, {
        scrollTo: { y: getScrollTarget(nextIndex) },
        duration: 0.0,
        ease: 'power2.inOut',
        onComplete: () => {
          setTimeout(() => { isAutoScrolling = false; }, 100);
        },
      });
    }

    window.addEventListener('wheel', handleWheel, { passive: false });
    window.addEventListener('touchstart', handleTouchStart, { passive: true });
    window.addEventListener('touchend', handleTouchEnd, { passive: true });

    window.addEventListener('cinematicModeChange', ((e: CustomEvent) => {
      cinematicMode = e.detail.enabled;
    }) as EventListener);
  }

  initCinematicScroll();

  document.addEventListener('astro:after-swap', () => {
    ScrollTrigger.getAll().forEach(st => st.kill());
    (window as any).__sectionTriggers = {};
    if (document.querySelector('.cine-section')) {
      initCinematicScroll();
    }
  });
</script>

<style>
  /* ---- Layout overrides ---- */
  :global(#main-content) {
    overflow: visible;
  }

  /* ---- Section Spacers ---- */
  .section-spacer {
    height: 35vh;
    position: relative;
  }

  /* ---- Cinematic Sections ---- */
  .cine-section {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--space-8) 0;
    box-sizing: border-box;
    overflow: hidden;
  }

  .cine-section::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      transparent 0%,
      rgba(10, 0, 0, 0.55) 12%,
      rgba(10, 0, 0, 0.55) 88%,
      transparent 100%
    );
    pointer-events: none;
    z-index: 0;
  }

  .hero::before {
    background: linear-gradient(
      to bottom,
      rgba(10, 0, 0, 0.55) 0%,
      rgba(10, 0, 0, 0.55) 88%,
      transparent 100%
    );
  }

  .cine-section > :global(*) {
    position: relative;
    z-index: 1;
  }

  .cine-heading {
    text-align: center;
    will-change: transform, opacity;
  }

  .cine-content {
    opacity: 0;
    will-change: transform, opacity;
  }

  /* ---- Reduced Motion ---- */
  @media (prefers-reduced-motion: reduce) {
    .cine-content {
      opacity: 1 !important;
      transform: none !important;
    }

    .cine-heading {
      transform: none !important;
      opacity: 1 !important;
    }
  }

  /* ---- Hero ---- */
  .hero {
    text-align: center;
    padding-bottom: calc(var(--space-8) + 80px);
  }

  .hero .cine-content {
    opacity: 1;
  }

  .hero-label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--text-secondary);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    margin-bottom: var(--space-6);
  }

  :global(.page-title) {
    font-size: var(--text-5xl);
    color: var(--text-primary);
    text-shadow:
      3px 3px 0 rgba(212, 84, 94, 0.3),
      -1px -1px 0 rgba(0, 0, 0, 0.5);
    margin-bottom: var(--space-6);
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    max-width: 650px;
    margin: 0 auto;
  }

  /* ---- Section Headings ---- */
  .group-number {
    font-family: var(--font-display);
    font-size: var(--text-5xl);
    font-weight: 700;
    color: var(--text-accent);
    opacity: 0.2;
    line-height: 1;
    margin-bottom: var(--space-2);
  }

  .section-heading {
    font-size: var(--text-4xl);
    text-align: center;
    margin-bottom: var(--space-4);
    color: var(--text-primary);
  }

  /* ---- Guides Grid ---- */
  .guides-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-6);
    max-width: 1000px;
    margin: 0 auto;
  }

  @media (max-width: 767px) {
    .guides-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---- Guide Cards ---- */
  .guide-card {
    display: flex;
    flex-direction: column;
    padding: var(--space-6);
    background: var(--bg-card);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-md);
    text-decoration: none;
    text-align: left;
    transition: all var(--transition-normal);
  }

  .guide-card:hover {
    border-color: var(--text-accent);
    transform: translateY(-2px);
  }

  .guide-card-number {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    font-weight: 700;
    color: var(--text-accent);
    opacity: 0.15;
    line-height: 1;
    margin-bottom: var(--space-2);
  }

  .guide-card :global(.badge) {
    margin-bottom: var(--space-3);
  }

  .guide-card h3 {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    color: var(--text-primary);
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .guide-card p {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    flex: 1;
  }

  .guide-cta {
    display: inline-block;
    margin-top: var(--space-4);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--text-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    transition: color var(--transition-fast);
  }

  .guide-card:hover .guide-cta {
    color: var(--text-primary);
  }

  /* ---- Completion Status ---- */
  .completion-status {
    margin-top: var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    opacity: 0.6;
  }

  .completion-status.is-completed {
    color: var(--text-accent);
    opacity: 1;
  }

  .status-icon {
    margin-right: var(--space-1);
  }
</style>
