---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlitchText from '../components/GlitchText.astro';

// Glossary data — also used by the tooltip system
const glossary: Record<string, string> = {
  "algo brain": "The state of having your attention and behavior shaped by algorithmic feeds — scrolling without intent, clicking bait, opening apps reflexively.",
  "arch linux": "An advanced Linux distribution known for its simplicity (in design, not setup) and rolling-release model. PewDiePie uses it on his laptop and Steam Deck.",
  "bootable usb": "A USB drive configured to start (boot) a computer into a different operating system. Used to install Linux.",
  "cli": "Command Line Interface. A text-based way of interacting with your computer using typed commands instead of clicking. Looks like hacking in movies.",
  "daily driver": "The device or software you use every day for real work, not just testing.",
  "de-google": "The process of systematically replacing Google services with privacy-respecting alternatives.",
  "desktop environment": "The graphical interface of a Linux system — the taskbar, file manager, settings, etc. Examples: GNOME, KDE, Cinnamon.",
  "distro": "Short for 'distribution.' A version of Linux packaged with specific software and design choices. Like flavors of ice cream — same base, different experience.",
  "dns blocker": "Software that blocks ads and trackers at the network level by intercepting domain name requests. Pi-Hole is the most popular one.",
  "docker": "A tool that runs applications in isolated containers. Makes self-hosting much easier — each service runs in its own box.",
  "dotfiles": "Configuration files (usually starting with a dot, like .bashrc) that control how your Linux system looks and behaves. Sharing dotfiles is part of ricing culture.",
  "dual-boot": "Running two operating systems on one computer. You choose which one to start when you turn on the machine.",
  "eww": "ElKowar's Wacky Widgets. A custom widget system used in Linux desktop ricing for creating custom UI elements.",
  "f-droid": "An app store for Android that only hosts free and open-source software. The Google Play Store alternative for privacy-focused phone users.",
  "friction": "One of the Two Pillars. Adding intentional delays to break automatic behavior — like a 5-second profile switch on your phone to stop reflexive app-opening.",
  "filtering": "One of the Two Pillars. Removing noise and unwanted content from your digital life — through self-hosting, extensions, DNS blocking, or unfollowing.",
  "grapheneos": "A privacy and security-focused mobile operating system based on Android. Only works on Google Pixel phones. PewDiePie uses it on his Pixel 9.",
  "hyprland": "A dynamic tiling Wayland compositor (window manager). Known for smooth animations and heavy customization. PewDiePie's window manager of choice.",
  "linux mint": "A beginner-friendly Linux distribution based on Ubuntu. PewDiePie's recommendation for first-time Linux users and his daily driver on his main desktop.",
  "local llm": "A Large Language Model running on your own hardware instead of a cloud service. Your prompts and data never leave your machine.",
  "microslop": "Microsoft Corporation. Called Microslop because their flagship product is a sloppy mess of telemetry, forced updates, and pre-installed bloatware that treats users like products.",
  "nextcloud": "Self-hosted cloud storage and collaboration platform. Replaces Google Drive, Calendar, Contacts, and more.",
  "ollama": "A tool that makes running local AI models as easy as running a Docker container. The easiest entry point for local AI.",
  "package manager": "Software that installs, updates, and removes programs on Linux. apt (Debian/Ubuntu/Mint), pacman (Arch), dnf (Fedora).",
  "pi-hole": "A DNS-level ad and tracker blocker that runs on a Raspberry Pi (or any Linux machine). Blocks ads for every device on your network.",
  "raspberry pi": "A small, cheap single-board computer. The Raspberry Pi 5 is popular for self-hosting. PewDiePie runs his server stack on one.",
  "ricing": "Customizing the visual appearance of your Linux desktop. Named after the car modding culture term. Deep rabbit hole. You've been warned.",
  "rofi": "An application launcher for Linux. Type a few letters, hit enter, and your app opens. Replaces the Start menu / app dock concept.",
  "rss": "Really Simple Syndication. A protocol that lets you subscribe to websites and get updates without an algorithm deciding what you see. The original 'feed' before social media ruined the word.",
  "self-hosting": "Running your own server to provide services (email, cloud storage, passwords) instead of relying on a company's servers.",
  "tech fencing": "The practice of building deliberate barriers between yourself and technology designed to exploit your attention and data. Coined by PewDiePie in his 'I Fixed YouTube!' video.",
  "tiling window manager": "A window manager that automatically arranges windows like tiles instead of stacking them. No overlapping. Keyboard-driven. Examples: Hyprland, i3, Sway.",
  "unhook": "A browser extension that removes the YouTube homepage feed, recommendations, and Shorts. A key friction/filtering tool in the tech fencing toolkit.",
  "vaultwarden": "A self-hosted, open-source password manager compatible with Bitwarden clients. PewDiePie self-hosts his on a Raspberry Pi (setup took 2 days).",
  "vllm": "A fast, memory-efficient inference engine for large language models. PewDiePie runs it on his 10-GPU rig for local AI.",
  "vps": "Virtual Private Server. A server you rent from a hosting company instead of running hardware at home. Alternative to Raspberry Pi for self-hosting.",
  "waybar": "A customizable status bar for Wayland compositors. Shows system info, workspaces, clock, etc. Part of the ricing toolkit.",
  "snap": "A package format by Canonical (Ubuntu). Auto-updating and sandboxed, but centrally controlled by Canonical. Controversial in the Linux community.",
  "flatpak": "A universal Linux package format. Apps run sandboxed, available from Flathub. The community-preferred alternative to Snap.",
  "system snapshots": "A saved state of your entire system. If an update breaks something, restore to a snapshot. Timeshift is the most popular tool on Linux.",
  "backup": "A copy of your data stored separately from the original. The 3-2-1 rule: 3 copies, 2 different media, 1 offsite.",
  "oem unlocking": "A setting that allows your phone's bootloader to be unlocked. Required for installing custom ROMs like GrapheneOS. Found in Developer Options on Android.",
};

const sortedTerms = Object.entries(glossary).sort(([a], [b]) => a.localeCompare(b));
const letters = [...new Set(sortedTerms.map(([term]) => term[0].toUpperCase()))];
---

<BaseLayout title="Glossary" description="Jargon-free definitions for every technical term on this site.">

  <section class="hero-sm">
    <div class="container">
      <GlitchText text="Glossary" tag="h1" class="page-title" />
      <p class="page-subtitle">
        Tech jargon can feel like a different language. Here's every term we use,
        explained like you're a normal person and not a sysadmin.
      </p>
    </div>
  </section>

  <div class="flowing-line"></div>

  <section class="section">
    <div class="container glossary-container">

      <div class="search-wrapper">
        <label for="glossary-search" class="sr-only">Search glossary terms</label>
        <input
          type="search"
          id="glossary-search"
          class="search-input"
          placeholder="Search terms…"
          aria-label="Search glossary terms"
          autocomplete="off"
          data-glossary-search
        />
      </div>

      <div class="glossary-list">
        <div class="search-no-results" data-no-results hidden>
          <p>No terms found. Try a different search or browse by letter.</p>
        </div>

        {letters.map(letter => (
          <div class="letter-group" id={`letter-${letter}`}>
            <h2 class="letter-heading">{letter}</h2>
            {sortedTerms
              .filter(([term]) => term[0].toUpperCase() === letter)
              .map(([term, definition]) => (
                <div class="glossary-entry" id={term.replace(/\s+/g, '-').toLowerCase()}>
                  <dt class="glossary-term">{term}</dt>
                  <dd class="glossary-definition">{definition}</dd>
                </div>
              ))}
          </div>
        ))}
      </div>

      <nav class="alpha-sidebar" aria-label="Jump to letter" data-alpha-sidebar>
        {letters.map(letter => (
          <a
            href={`#letter-${letter}`}
            class="alpha-letter"
            data-alpha-letter={letter}
            aria-label={`Jump to letter ${letter}`}
          >{letter}</a>
        ))}
      </nav>

    </div>
  </section>

</BaseLayout>

<script>
  const NAVBAR_OFFSET = 80;
  const DEBOUNCE_MS = 200;

  const input = document.querySelector<HTMLInputElement>('[data-glossary-search]');
  const entries = document.querySelectorAll<HTMLElement>('.glossary-entry');
  const groups = document.querySelectorAll<HTMLElement>('.letter-group');
  const noResults = document.querySelector<HTMLElement>('[data-no-results]');
  const sidebarLinks = document.querySelectorAll<HTMLAnchorElement>('[data-alpha-letter]');

  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // --- Search ---

  let debounceTimer: ReturnType<typeof setTimeout>;

  input?.addEventListener('input', () => {
    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => filterGlossary(input.value.trim()), DEBOUNCE_MS);
  });

  function escapeRegex(str: string): string {
    return str.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
  }

  function getOriginal(el: HTMLElement): string {
    if (!el.dataset.original) {
      el.dataset.original = el.textContent || '';
    }
    return el.dataset.original;
  }

  function resetHighlight(el: HTMLElement): void {
    const original = getOriginal(el);
    el.textContent = original;
  }

  function applyHighlight(el: HTMLElement, query: string): void {
    const original = getOriginal(el);
    const regex = new RegExp(`(${escapeRegex(query)})`, 'gi');
    el.innerHTML = original.replace(regex, '<mark class="search-highlight">$1</mark>');
  }

  function filterGlossary(query: string): void {
    const lowerQuery = query.toLowerCase();
    let visibleCount = 0;

    entries.forEach(entry => {
      const term = entry.querySelector<HTMLElement>('.glossary-term')!;
      const def = entry.querySelector<HTMLElement>('.glossary-definition')!;
      const termText = getOriginal(term).toLowerCase();
      const defText = getOriginal(def).toLowerCase();

      resetHighlight(term);
      resetHighlight(def);

      if (!query || termText.includes(lowerQuery) || defText.includes(lowerQuery)) {
        entry.hidden = false;
        visibleCount++;
        if (query) {
          applyHighlight(term, query);
          applyHighlight(def, query);
        }
      } else {
        entry.hidden = true;
      }
    });

    groups.forEach(group => {
      const hasVisible = group.querySelector('.glossary-entry:not([hidden])');
      group.hidden = !hasVisible;
    });

    if (noResults) {
      noResults.hidden = visibleCount > 0 || !query;
    }

    updateSidebarDimming();
  }

  // --- Sidebar: dim letters with no visible entries during search ---

  function updateSidebarDimming(): void {
    sidebarLinks.forEach(link => {
      const letter = link.dataset.alphaLetter;
      const group = document.getElementById(`letter-${letter}`);
      link.classList.toggle('is-dimmed', !!group?.hidden);
    });
  }

  // --- Sidebar: active letter tracking via IntersectionObserver ---

  const observer = new IntersectionObserver(
    (observedEntries) => {
      observedEntries.forEach(entry => {
        if (entry.isIntersecting) {
          const letter = entry.target.id.replace('letter-', '');
          sidebarLinks.forEach(link => {
            link.classList.toggle('is-active', link.dataset.alphaLetter === letter);
          });
        }
      });
    },
    {
      rootMargin: `-${NAVBAR_OFFSET}px 0px -60% 0px`,
      threshold: 0,
    }
  );

  groups.forEach(group => observer.observe(group));

  // --- Sidebar: click-to-scroll with navbar offset ---

  sidebarLinks.forEach(link => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const targetId = link.getAttribute('href')?.slice(1);
      if (!targetId) return;
      const target = document.getElementById(targetId);
      if (!target) return;

      const y = target.getBoundingClientRect().top + window.scrollY - NAVBAR_OFFSET;
      window.scrollTo({ top: y, behavior: prefersReducedMotion ? 'instant' : 'smooth' });
    });
  });
</script>

<style>
  .hero-sm {
    padding: var(--space-12) 0 var(--space-8);
    text-align: center;
    background: rgba(10, 0, 0, 0.6);
  }

  :global(.page-title) {
    font-size: var(--text-4xl);
    margin-bottom: var(--space-4);
  }

  .page-subtitle {
    max-width: 600px;
    margin: 0 auto;
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  /* Grid layout */
  .glossary-container {
    max-width: 900px;
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-4);
  }

  @media (min-width: 768px) {
    .glossary-container {
      grid-template-columns: 1fr 32px;
    }
  }

  /* Search */
  .search-wrapper {
    grid-column: 1 / -1;
    margin-bottom: var(--space-2);
  }

  .search-input {
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--bg-card);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-md);
    color: var(--text-primary);
    font-family: var(--font-body);
    font-size: var(--text-base);
    outline: none;
    transition: border-color var(--transition-fast);
  }

  .search-input:focus {
    border-color: var(--text-accent);
    box-shadow: 0 0 0 2px rgba(212, 84, 94, 0.15);
  }

  .search-input::placeholder {
    color: var(--text-muted);
  }

  .search-no-results {
    padding: var(--space-8) 0;
    text-align: center;
    color: var(--text-muted);
    font-family: var(--font-display);
  }

  /* Alphabet sidebar */
  .alpha-sidebar {
    display: flex;
    flex-wrap: wrap;
    gap: 2px;
    justify-content: center;
    padding: var(--space-2);
    background: var(--bg-card);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-md);
    margin-bottom: var(--space-4);
    grid-column: 1 / -1;
    order: -1;
  }

  .alpha-letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--text-muted);
    text-decoration: none;
    border-radius: var(--radius-sm);
    transition: color var(--transition-fast), background var(--transition-fast), opacity var(--transition-fast);
  }

  .alpha-letter:hover {
    color: var(--text-accent);
    background: rgba(212, 84, 94, 0.08);
  }

  .alpha-letter.is-active {
    color: var(--text-accent);
    background: rgba(212, 84, 94, 0.15);
  }

  .alpha-letter.is-dimmed {
    opacity: 0.25;
    pointer-events: none;
  }

  @media (min-width: 768px) {
    .alpha-sidebar {
      flex-direction: column;
      flex-wrap: nowrap;
      position: sticky;
      top: 80px;
      align-self: start;
      grid-column: 2;
      order: 0;
      margin-bottom: 0;
      padding: var(--space-2) var(--space-1);
      background: transparent;
      border: none;
      gap: 0;
      max-height: calc(100vh - 100px);
      overflow-y: auto;
    }

    .alpha-letter {
      width: 24px;
      height: 22px;
      font-size: 0.65rem;
    }
  }

  /* Glossary list */
  .glossary-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .letter-heading {
    font-family: var(--font-display);
    font-size: var(--text-3xl);
    color: var(--text-accent);
    opacity: 0.3;
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--border-muted);
  }

  .glossary-entry {
    padding: var(--space-4) 0;
    border-bottom: 1px solid rgba(212, 84, 94, 0.06);
  }

  .glossary-entry:last-child {
    border-bottom: none;
  }

  .glossary-term {
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
    color: var(--text-primary);
    text-transform: capitalize;
    margin-bottom: var(--space-2);
  }

  .glossary-definition {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
    margin: 0;
    padding: 0;
  }

  :global(.search-highlight) {
    background: rgba(212, 84, 94, 0.25);
    color: var(--text-primary);
    border-radius: 2px;
    padding: 0 1px;
  }
</style>
