---
import BaseLayout from '../layouts/BaseLayout.astro';
import GlitchText from '../components/GlitchText.astro';
import '../styles/tldr.css';

const trinity = [
  { id: 'pVI_smLgTY0', title: 'I installed Linux (so should you)' },
  { id: 'u_Lxkt50xOg', title: "I'm DONE with Google" },
  { id: '5nL-Eq1lpDU', title: 'I Fixed YouTube!' },
];

const categories = [
  {
    label: 'Linux',
    videos: [
      { id: 'DB5mk6bQt9A', title: 'Every Linux Distro Explained' },
      { id: 'cnb_XGULKbc', title: 'Every Linux Desktop Explained' },
    ],
  },
  {
    label: 'Privacy',
    videos: [
      { id: '8_J0SS21ep0', title: 'Best & Worst Browsers for Privacy (2026)' },
      { id: 'aGibWKd3KP8', title: 'My 2026 Privacy Stack' },
    ],
  },
  {
    label: 'De-Google',
    videos: [
      { id: '8eLJlLkyuMA', title: 'I Self-Hosted Everything… The Truth' },
      { id: 'XOcfMVXmkfM', title: 'Ultimate Degoogle Tutorial' },
    ],
  },
];
---

<BaseLayout title="TL;DR — Just Watch These" activePage="tldr" description="Don't want to read? Just watch the videos that started it all.">

  <section class="tldr-hero">
    <div class="container">
      <GlitchText text="TL;DR" tag="h1" class="page-title" />
      <p class="tldr-hero-sub">
        Three videos started everything. Seven more go deeper. Just hit play.
      </p>
    </div>
  </section>

  <div class="flowing-line"></div>

  <!-- THE HOLY TRINITY -->
  <section class="tldr-sect">
    <div class="container">
      <h2 class="tldr-label">The Holy Trinity</h2>
      <div class="tldr-card-wrap">
        <div class="tldr-grid-3">
          {trinity.map(v => (
            <a href={`https://youtu.be/${v.id}`} target="_blank" rel="noopener noreferrer" class="tldr-vid">
              <img src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt={v.title} loading="lazy" />
              <div class="tldr-vid-overlay">
                <svg width="40" height="40" viewBox="0 0 48 48" fill="none">
                  <circle cx="24" cy="24" r="23" stroke="currentColor" stroke-width="2" opacity="0.8" />
                  <path d="M19 14L35 24L19 34V14Z" fill="currentColor" opacity="0.9" />
                </svg>
              </div>
              <span class="tldr-vid-title">{v.title}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- FAVORITE VIDEO -->
  <section class="tldr-sect">
    <div class="container">
      <h2 class="tldr-label">My Favorite Of All</h2>
      <div class="tldr-card-wrap tldr-featured-wrap">
        <a href="https://youtu.be/AtgCcMjtqF0" target="_blank" rel="noopener noreferrer" class="tldr-featured">
          <div class="tldr-featured-thumb">
            <img src="https://i.ytimg.com/vi/AtgCcMjtqF0/mqdefault.jpg" alt="I Spent a Year Replacing My Subscriptions" loading="lazy" />
            <div class="tldr-vid-overlay">
              <svg width="48" height="48" viewBox="0 0 48 48" fill="none">
                <circle cx="24" cy="24" r="23" stroke="currentColor" stroke-width="2" opacity="0.8" />
                <path d="M19 14L35 24L19 34V14Z" fill="currentColor" opacity="0.9" />
              </svg>
            </div>
          </div>
          <div class="tldr-featured-info">
            <h3>I Spent a Year Replacing My Subscriptions. Here's How.</h3>
            <p>
              In this single video, all of the concepts of this site are found.
              Browsers, Linux, self-hosting, de-Googling, privacy — everything
              covered in one place. If you only watch one video, make it this one.
            </p>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- GO DEEPER — 3 categories -->
  <section class="tldr-sect">
    <div class="container">
      <h2 class="tldr-label">Go Deeper</h2>
      <div class="tldr-cat-grid">
        {categories.map(cat => (
          <div class="tldr-cat">
            <span class="tldr-cat-label">{cat.label}</span>
            <div class="tldr-cat-videos">
              {cat.videos.map(v => (
                <a href={`https://youtu.be/${v.id}`} target="_blank" rel="noopener noreferrer" class="tldr-vid tldr-vid-sm">
                  <img src={`https://i.ytimg.com/vi/${v.id}/mqdefault.jpg`} alt={v.title} loading="lazy" />
                  <div class="tldr-vid-overlay">
                    <svg width="32" height="32" viewBox="0 0 48 48" fill="none">
                      <circle cx="24" cy="24" r="23" stroke="currentColor" stroke-width="2" opacity="0.8" />
                      <path d="M19 14L35 24L19 34V14Z" fill="currentColor" opacity="0.9" />
                    </svg>
                  </div>
                  <span class="tldr-vid-title">{v.title}</span>
                </a>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="flowing-line"></div>

  <!-- ALSO IN TL;DR -->
  <section class="tldr-sect">
    <div class="container">
      <h2 class="tldr-label">Also In TL;DR</h2>
      <div class="tldr-links-row">
        <a href="/arsenal" class="tldr-link-card">
          <h3>Our Savior's Arsenal</h3>
          <p>Every piece of hardware and software PewDiePie actually uses — verified from videos.</p>
          <span class="tldr-link-cta">View The Arsenal →</span>
        </a>
        <a href="/damned" class="tldr-link-card">
          <h3>The Damned</h3>
          <p>Browsers, apps, and services we don't recommend — and why. They all take something.</p>
          <span class="tldr-link-cta">View The Damned →</span>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="tldr-cta-sect">
    <div class="container" style="text-align: center; max-width: 600px;">
      <h2 class="glitch-hover" data-text="Ready to Start?">Ready to Start?</h2>
      <p class="tldr-cta-desc">Pick a layer. Start building your fence.</p>
      <a href="/bible" class="tldr-cta-btn">Open The Bible →</a>
    </div>
  </section>

</BaseLayout>

