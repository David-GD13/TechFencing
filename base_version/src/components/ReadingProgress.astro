---
interface Props {
  pageId: string;
  label?: string;
}

const { pageId, label = 'Mark as completed' } = Astro.props;
---

<div class="reading-progress" data-page-id={pageId}>
  <label class="progress-toggle">
    <input type="checkbox" class="progress-checkbox" />
    <span class="progress-switch">
      <svg class="progress-check" width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M3 7l3 3 5-5" />
      </svg>
    </span>
    <span class="progress-label">{label}</span>
  </label>
</div>

<script>
  function initReadingProgress() {
    const STORAGE_KEY = 'tf-progress';

    type PageProgress = { completed: boolean; steps: Record<string, boolean> };
    type ProgressData = Record<string, boolean | PageProgress>;

    function getRawProgress(): ProgressData {
      try {
        return JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
      } catch {
        return {};
      }
    }

    function getPageProgress(pageId: string): PageProgress {
      const raw = getRawProgress();
      const entry = raw[pageId];
      // Migrate old boolean format
      if (entry === true) {
        return { completed: true, steps: {} };
      }
      if (entry && typeof entry === 'object') {
        return entry as PageProgress;
      }
      return { completed: false, steps: {} };
    }

    function isPageCompleted(pageId: string): boolean {
      const raw = getRawProgress();
      const entry = raw[pageId];
      if (entry === true) return true;
      if (entry && typeof entry === 'object') return (entry as PageProgress).completed;
      return false;
    }

    function savePageProgress(pageId: string, data: PageProgress) {
      const raw = getRawProgress();
      if (!data.completed && Object.keys(data.steps).length === 0) {
        delete raw[pageId];
      } else {
        raw[pageId] = data;
      }
      localStorage.setItem(STORAGE_KEY, JSON.stringify(raw));

      window.dispatchEvent(new CustomEvent('reading-progress-change', {
        detail: { pageId, completed: data.completed }
      }));
    }

    // Init all hero progress toggles on the page
    document.querySelectorAll<HTMLElement>('.reading-progress').forEach(el => {
      const pageId = el.dataset.pageId;
      if (!pageId) return;

      const checkbox = el.querySelector<HTMLInputElement>('.progress-checkbox');
      const label = el.querySelector('.progress-label');
      if (!checkbox) return;

      const pageData = getPageProgress(pageId);
      checkbox.checked = pageData.completed;
      if (checkbox.checked && label) {
        label.textContent = 'Completed';
      }

      checkbox.addEventListener('change', () => {
        const data = getPageProgress(pageId);
        data.completed = checkbox.checked;

        // Bidirectional: hero toggle controls all step checkboxes
        const stepBoxes = document.querySelectorAll<HTMLInputElement>('input[data-step-checkbox]');
        stepBoxes.forEach(stepBox => {
          const idx = stepBox.dataset.stepIndex;
          if (idx) {
            data.steps[idx] = checkbox.checked;
            stepBox.checked = checkbox.checked;
            updateStepLabel(stepBox);
          }
        });

        savePageProgress(pageId, data);
        if (label) {
          label.textContent = checkbox.checked ? 'Completed' : 'Mark as completed';
        }
      });
    });

    // Init step checkboxes
    const stepBoxes = document.querySelectorAll<HTMLInputElement>('input[data-step-checkbox]');
    if (stepBoxes.length > 0) {
      // Find the pageId from the hero reading-progress element
      const heroEl = document.querySelector<HTMLElement>('.reading-progress[data-page-id]');
      const pageId = heroEl?.dataset.pageId;
      if (pageId) {
        const pageData = getPageProgress(pageId);

        stepBoxes.forEach(stepBox => {
          const idx = stepBox.dataset.stepIndex;
          if (!idx) return;

          // If page was completed (including old format migration), check all steps
          stepBox.checked = pageData.completed || !!pageData.steps[idx];
          updateStepLabel(stepBox);

          stepBox.addEventListener('change', () => {
            const data = getPageProgress(pageId);
            data.steps[idx] = stepBox.checked;

            // Check if all steps are now completed
            const allSteps = document.querySelectorAll<HTMLInputElement>('input[data-step-checkbox]');
            const allChecked = Array.from(allSteps).every(s => s.checked);
            const anyChecked = Array.from(allSteps).some(s => s.checked);
            data.completed = allChecked;

            // Update hero checkbox
            const heroCheckbox = heroEl?.querySelector<HTMLInputElement>('.progress-checkbox');
            const heroLabel = heroEl?.querySelector('.progress-label');
            if (heroCheckbox) {
              heroCheckbox.checked = allChecked;
              if (heroLabel) {
                heroLabel.textContent = allChecked ? 'Completed' : 'Mark as completed';
              }
            }

            updateStepLabel(stepBox);
            savePageProgress(pageId, data);
          });
        });
      }
    }

    function updateStepLabel(stepBox: HTMLInputElement) {
      const label = stepBox.closest('.step-progress')?.querySelector('.step-progress-label');
      if (label) {
        label.textContent = stepBox.checked ? 'Done' : 'Mark step as done';
      }
    }

    // Add checkmarks to navbar dropdown items
    updateNavProgress();
  }

  function updateNavProgress() {
    const STORAGE_KEY = 'tf-progress';
    let raw: Record<string, any>;
    try {
      raw = JSON.parse(localStorage.getItem(STORAGE_KEY) || '{}');
    } catch {
      raw = {};
    }

    const idToHref: Record<string, string> = {
      'guides/browsers': '/guides/browsers',
      'guides/linux': '/guides/linux',
      'guides/de-google': '/guides/de-google',
      'guides/self-hosting': '/guides/self-hosting',
      'guides/open-source-alternatives': '/guides/open-source-alternatives',
      'guides/fix-youtube': '/guides/fix-youtube',
      'guides/control-your-phone': '/guides/control-your-phone',
      'guides/own-your-ai': '/guides/own-your-ai',
      'guides/ricing': '/guides/ricing',
      'bible/layer-1-os': '/bible/layer-1-os',
      'bible/layer-2-services': '/bible/layer-2-services',
      'bible/layer-3-behavior': '/bible/layer-3-behavior',
    };

    for (const [pageId, href] of Object.entries(idToHref)) {
      const entry = raw[pageId];
      const completed = entry === true || (entry && typeof entry === 'object' && entry.completed);
      if (!completed) continue;

      document.querySelectorAll<HTMLAnchorElement>(`a[href="${href}"]`).forEach(link => {
        if (link.querySelector('.nav-check')) return;
        const check = document.createElement('span');
        check.className = 'nav-check';
        check.setAttribute('aria-label', 'completed');
        check.textContent = ' ✓';
        link.appendChild(check);
      });
    }
  }

  // Run on page load
  initReadingProgress();

  // Re-run on Astro page transitions
  document.addEventListener('astro:after-swap', () => {
    initReadingProgress();
  });

  // Update nav when progress changes (from this or other tabs)
  window.addEventListener('reading-progress-change', () => {
    document.querySelectorAll('.nav-check').forEach(el => el.remove());
    updateNavProgress();
  });
</script>

<style>
  .reading-progress {
    margin-top: var(--space-4);
  }

  .progress-toggle {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    cursor: pointer;
    user-select: none;
  }

  .progress-checkbox {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }

  .progress-switch {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border: 2px solid var(--border-muted);
    border-radius: var(--radius-sm);
    background: var(--bg-card);
    transition: all var(--transition-fast);
    flex-shrink: 0;
  }

  .progress-check {
    opacity: 0;
    color: var(--bg-base);
    transition: opacity var(--transition-fast);
  }

  .progress-checkbox:checked + .progress-switch {
    background: var(--text-accent);
    border-color: var(--text-accent);
  }

  .progress-checkbox:checked + .progress-switch .progress-check {
    opacity: 1;
  }

  .progress-checkbox:focus-visible + .progress-switch {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }

  .progress-toggle:hover .progress-switch {
    border-color: var(--text-accent);
  }

  .progress-label {
    font-family: var(--font-display);
    font-size: var(--text-xs);
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
  }

  .progress-checkbox:checked ~ .progress-label {
    color: var(--text-accent);
  }

  :global(.nav-check) {
    color: var(--text-accent);
    font-size: var(--text-xs);
    margin-left: var(--space-1);
  }
</style>
