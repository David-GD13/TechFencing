---
// Browser blocker component — detects Chrome, Edge, Opera, Puffin
// Whitelists: Brave, Firefox, LibreWolf, Safari
import WavyShader from './WavyShader.astro';
---

<div id="browser-blocker" class="blocker hidden" aria-live="assertive">
  <WavyShader position="absolute" opacity={0.1} scale={3.5} rotation={0.6} grain={3} thickness={2.6} speed={5} />
  <canvas id="crt-canvas" class="crt-canvas"></canvas>
  <div class="blocker-content">
    <h1 id="blocker-title" class="blocker-title glitch-text" data-text=""></h1>
    <div class="flowing-line"></div>
    <p class="blocker-subtitle">
      ...on a privacy website. Bold move.
    </p>
    <p class="blocker-message">
      This is literally a website about digital privacy, and you showed up in a
      browser that tracks everything you do. The irony is not lost on us.
    </p>
    <div class="blocker-alternatives">
      <p>Try one of these instead:</p>
      <div class="alt-grid">
        <a href="https://www.firefox.com/" target="_blank" rel="noopener noreferrer" class="alt-card">
          <img src="/images/firefox-logo.webp" alt="Firefox logo" class="alt-logo" width="36" height="36" />
          <div class="alt-info">
            <strong>Firefox</strong>
            <span>To be hardened — what PewDiePie uses</span>
          </div>
        </a>
        <a href="https://librewolf.net/" target="_blank" rel="noopener noreferrer" class="alt-card">
          <img src="/images/LibreWolf_icon.webp" alt="LibreWolf logo" class="alt-logo" width="36" height="36" />
          <div class="alt-info">
            <strong>LibreWolf</strong>
            <span>Pre-hardened Firefox, easy install</span>
          </div>
        </a>
        <a href="https://brave.com/" target="_blank" rel="noopener noreferrer" class="alt-card">
          <img src="/images/Brave_lion_icon.webp" alt="Brave logo" class="alt-logo" width="36" height="36" />
          <div class="alt-info">
            <strong>Brave</strong>
            <span>Chromium without the Google</span>
          </div>
        </a>
        <a href="https://mullvad.net/en/browser" target="_blank" rel="noopener noreferrer" class="alt-card">
          <img src="/images/Mullvad_Browser_logo.webp" alt="Mullvad Browser logo" class="alt-logo" width="36" height="36" />
          <div class="alt-info">
            <strong>Mullvad Browser</strong>
            <span>The cybersecurity experts' choice</span>
          </div>
        </a>
      </div>
    </div>
    <button id="blocker-dismiss" class="blocker-btn" type="button">
      I know, I know... let me in anyway
    </button>
  </div>
</div>

<script>
  function detectBrowser(): string | null {
    const ua = navigator.userAgent;

    // Check Brave first (it masquerades as Chrome)
    if ((navigator as any).brave?.isBrave) return null;

    // Puffin
    if (ua.includes('Puffin')) return 'Puffin';

    // Opera
    if (ua.includes('OPR/') || ua.includes('Opera')) return 'Opera';

    // Edge
    if (ua.includes('Edg/')) return 'Microsoft Edge';

    // Chrome (must come after Edge/Opera/Brave checks)
    if (ua.includes('Chrome/') && !ua.includes('Edg/') && !ua.includes('OPR/')) return 'Google Chrome';

    return null;
  }

  function initBlocker() {
    // Check if user dismissed this session
    if (sessionStorage.getItem('tf-blocker-dismissed') === 'true') return;

    const blockedBrowser = detectBrowser();
    if (!blockedBrowser) return;

    const blocker = document.getElementById('browser-blocker');
    const mainApp = document.getElementById('main-app');
    const dismissBtn = document.getElementById('blocker-dismiss');

    if (!blocker || !mainApp) return;

    // Set dynamic title
    const titleEl = document.getElementById('blocker-title');
    const titleText = `You're using ${blockedBrowser}`;
    if (titleEl) {
      titleEl.textContent = titleText;
      titleEl.setAttribute('data-text', titleText);
    }

    // Show blocker
    blocker.classList.remove('hidden');
    mainApp.style.display = 'none';
    document.body.style.overflow = 'hidden';

    // Defer shader + CRT init to next frame so layout has settled
    requestAnimationFrame(() => {
      const shaderCanvas = blocker.querySelector<HTMLCanvasElement>('.wavy-shader');
      if (shaderCanvas && (window as any).__initWavyShader) {
        (window as any).__initWavyShader(shaderCanvas);
      }
      initCRTEffect();
    });

    // Dismiss handler — reload for a clean slate (avoids stale ScrollTrigger state)
    dismissBtn?.addEventListener('click', () => {
      sessionStorage.setItem('tf-blocker-dismissed', 'true');
      window.location.reload();
    });
  }

  let crtAnimationId: number | null = null;

  function initCRTEffect() {
    const canvas = document.getElementById('crt-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    // Check reduced motion
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    function resize() {
      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;
    }
    resize();
    window.addEventListener('resize', resize);

    let time = 0;

    function draw() {
      if (!ctx) return;
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Flowing scanlines with sinusoidal distortion
      for (let y = 0; y < canvas.height; y += 3) {
        const offset = Math.sin((y + time) * 0.02) * 2;
        const alpha = 0.03 + Math.sin((y + time * 0.5) * 0.01) * 0.02;

        ctx.strokeStyle = `rgba(212, 84, 94, ${Math.max(0, alpha)})`;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.moveTo(offset, y);
        ctx.lineTo(canvas.width + offset, y);
        ctx.stroke();
      }

      // Occasional bright scanline band
      const bandY = (time * 0.5) % canvas.height;
      ctx.fillStyle = 'rgba(212, 84, 94, 0.04)';
      ctx.fillRect(0, bandY, canvas.width, 40);

      time += 1;
      crtAnimationId = requestAnimationFrame(draw);
    }

    draw();
  }

  function stopCRTEffect() {
    if (crtAnimationId !== null) {
      cancelAnimationFrame(crtAnimationId);
      crtAnimationId = null;
    }
  }

  document.addEventListener('DOMContentLoaded', initBlocker);
</script>

<style>
  .blocker {
    position: fixed;
    inset: 0;
    z-index: var(--z-blocker);
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(10, 0, 0, 0.7);
    overflow: hidden;
  }

  .blocker.hidden {
    display: none;
  }

  .crt-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .blocker-content {
    position: relative;
    z-index: 1;
    max-width: 600px;
    padding: var(--space-4) var(--space-8);
    text-align: center;
  }

  .blocker-title {
    font-family: var(--font-display);
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    font-weight: 700;
    color: var(--text-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    text-shadow:
      4px 4px 0 rgba(212, 84, 94, 0.3),
      -2px -2px 0 rgba(0, 0, 0, 0.8);
    margin-bottom: var(--space-3);
  }

  .blocker-subtitle {
    font-size: var(--text-xl);
    color: var(--text-primary);
    margin-bottom: var(--space-2);
  }

  .blocker-message {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    margin-bottom: var(--space-4);
    line-height: var(--leading-relaxed);
  }

  .blocker-alternatives {
    text-align: left;
    background: rgba(212, 84, 94, 0.05);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-md);
    padding: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .blocker-alternatives > p {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--text-accent);
    text-transform: uppercase;
    margin-bottom: var(--space-3);
  }

  .alt-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-1);
  }

  .alt-card {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-3);
    text-decoration: none;
    color: var(--text-secondary);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    transition: all var(--transition-normal);
  }

  .alt-card:hover {
    background: rgba(212, 84, 94, 0.08);
    border-color: var(--border-primary);
    box-shadow: var(--shadow-glow);
    transform: translateX(4px);
  }

  .alt-card:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }

  .alt-logo {
    width: 48px;
    height: 48px;
    object-fit: contain;
    flex-shrink: 0;
    filter: grayscale(0.3);
    transition: filter var(--transition-normal);
  }

  .alt-card:hover .alt-logo {
    filter: grayscale(0);
  }

  .alt-info {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    text-align: left;
  }

  .alt-info strong {
    font-family: var(--font-display);
    font-size: var(--text-sm);
    color: var(--text-primary);
  }

  .alt-info span {
    font-size: var(--text-xs);
    color: var(--text-secondary);
    opacity: 0.7;
  }

  .blocker-btn {
    display: inline-block;
    padding: var(--space-3) var(--space-6);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    background: rgba(10, 0, 0, 0.6);
    border: 1px dashed var(--border-primary);
    border-radius: var(--radius-sm);
    cursor: pointer;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    transition: all var(--transition-normal);
  }

  .blocker-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-primary);
    background: rgba(212, 84, 94, 0.05);
  }

  .blocker-btn:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .alt-card:hover {
      transform: none;
    }
  }
</style>
