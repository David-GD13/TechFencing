---
interface Props {
  title: string;
  href?: string;
  class?: string;
  accent?: boolean;
}

const { title, href, class: className = '', accent = false } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={['card', { 'card--accent': accent, 'card--link': !!href }, className]}
  href={href}
>
  <div class="card-inner">
    <h3 class="card-title glitch-hover" data-text={title}>{title}</h3>
    <div class="card-body">
      <slot />
    </div>
  </div>
</Tag>

<style>
  .card {
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
    transition: all var(--transition-normal);
    text-decoration: none;
    color: inherit;
  }

  .card--link {
    cursor: pointer;
  }

  .card:hover {
    transform: translate(-2px, -2px);
    border-color: var(--border-primary);
    box-shadow: var(--shadow-card-hover);
    background: var(--bg-card-hover);
  }

  .card--accent {
    border-color: var(--border-primary);
    border-style: dashed;
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-3);
  }

  .card-body {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .card-body :global(p) {
    margin-bottom: var(--space-2);
  }

  .card-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
