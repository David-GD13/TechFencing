---
interface Props {
  title: string;
  href?: string;
  class?: string;
  accent?: boolean;
  icon?: string;
}

const { title, href, class: className = '', accent = false, icon } = Astro.props;
const Tag = href ? 'a' : 'div';
---

<Tag
  class:list={['card', { 'card--accent': accent, 'card--link': !!href }, className]}
  href={href}
>
  {icon && <img src={icon} alt="" class="card-bg-icon" width="120" height="120" />}
  <div class="card-inner">
    <h3 class="card-title glitch-hover" data-text={title}>{title}</h3>
    <div class="card-body">
      <slot />
    </div>
  </div>
</Tag>

<style>
  .card {
    display: block;
    background: rgba(26, 29, 35, 0.5);
    backdrop-filter: blur(4px);
    border: 1px solid var(--border-muted);
    border-radius: var(--radius-md);
    padding: var(--space-6);
    box-shadow: var(--shadow-card);
    transition: all var(--transition-normal);
    text-decoration: none;
    color: inherit;
    position: relative;
    overflow: hidden;
  }

  .card-bg-icon {
    position: absolute;
    right: -10px;
    bottom: -10px;
    width: 120px;
    height: 120px;
    opacity: 0.08;
    pointer-events: none;
    user-select: none;
    object-fit: contain;
  }

  .card--link {
    cursor: pointer;
    background: var(--bg-card);
    backdrop-filter: none;
  }

  .card--link:hover {
    transform: translateY(-2px);
    border-color: var(--border-primary);
    box-shadow: var(--shadow-card-hover);
    background: var(--bg-card-hover);
  }

  .card--accent {
    border-color: var(--border-primary);
  }

  .card-title {
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 700;
    color: var(--text-accent);
    text-transform: uppercase;
    letter-spacing: var(--tracking-wide);
    margin-bottom: var(--space-3);
  }

  .card-body {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: var(--leading-relaxed);
  }

  .card-body :global(.badge) {
    margin-bottom: var(--space-3);
  }

  .card-body :global(p) {
    margin-bottom: var(--space-2);
  }

  .card-body :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
