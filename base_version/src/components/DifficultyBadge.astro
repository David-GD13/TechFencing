---
interface Props {
  level: 1 | 2 | 3 | 4 | 5;
  label?: string;
  class?: string;
}

const { level, label, class: className = '' } = Astro.props;

const levelInfo: Record<number, { text: string; time: string }> = {
  1: { text: 'Beginner', time: '5 min' },
  2: { text: 'Easy', time: 'An afternoon' },
  3: { text: 'Moderate', time: 'A weekend' },
  4: { text: 'Advanced', time: 'Ongoing' },
  5: { text: 'Rabbit Hole', time: 'Forever' },
};

const info = levelInfo[level];
---

<span class:list={['badge', `badge--level-${level}`, className]} title={`Level ${level}: ${info.text} — ${info.time}`}>
  <span class="badge-level">LVL {level}</span>
  {label && <span class="badge-label">{label}</span>}
  {!label && <span class="badge-label">{info.text}</span>}
</span>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: var(--tracking-wider);
    border: 1px solid;
    border-radius: var(--radius-sm);
  }

  .badge-level {
    opacity: 0.7;
  }

  .badge--level-1 {
    color: #a3be8c;
    border-color: rgba(163, 190, 140, 0.3);
    background: rgba(163, 190, 140, 0.08);
  }

  .badge--level-2 {
    color: #88c0d0;
    border-color: rgba(136, 192, 208, 0.3);
    background: rgba(136, 192, 208, 0.08);
  }

  .badge--level-3 {
    color: #e5c07b;
    border-color: rgba(229, 192, 123, 0.3);
    background: rgba(229, 192, 123, 0.08);
  }

  .badge--level-4 {
    color: #fab387;
    border-color: rgba(250, 179, 135, 0.3);
    background: rgba(250, 179, 135, 0.08);
  }

  .badge--level-5 {
    color: #e06c75;
    border-color: rgba(224, 108, 117, 0.3);
    background: rgba(224, 108, 117, 0.08);
  }
</style>
