---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import BrowserBlocker from '../components/BrowserBlocker.astro';

interface Props {
  title: string;
  description?: string;
  activePage?: string;
}

const {
  title,
  description = "Build your tech fence. Take control of your data, privacy, and digital life — inspired by PewDiePie's journey.",
  activePage = ''
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={description} />
  <title>{title} | TechFencing</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <script src="../scripts/glossary-tooltip.ts"></script>
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <BrowserBlocker />

  <div id="main-app">
    <Navbar activePage={activePage} />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </div>
</body>
</html>

<style is:global>
  @import '../styles/tokens.css';
  @import '../styles/global.css';
  @import '../styles/effects.css';
</style>
